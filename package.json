{
  "name": "dsh-workspace-search",
  "version": "0.1.0",
  "description": "VS Code-style workspace keyword search tab for the dsh web GUI, registered into dsh-better-sidebar",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-better-sidebar": "^0.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "AmmiWang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmmiWang/dsh-workspace-search.git"
  },
  "homepage": "https://github.com/AmmiWang/dsh-workspace-search#readme",
  "bugs": {
    "url": "https://github.com/AmmiWang/dsh-workspace-search/issues"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "search",
    "workspace",
    "better-sidebar"
  ]
}
